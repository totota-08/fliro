rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // アバター画像: 認証済みユーザーが自分のディレクトリにのみアップロード可能
    match /avatars/{userId}/{allPaths=**} {
      // 読み取り: 誰でも可能
      allow read: if true;
      // 書き込み: 認証済みかつ自分のディレクトリのみ
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // 5MB制限
                   && request.resource.contentType.matches('image/.*');  // 画像のみ
    }

    // プロジェクトアイコン: プロジェクトメンバーのみアクセス可能
    match /projects/{projectId}/icon/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // デフォルト: すべて拒否
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
