{
  "name": "fliro",
  "private": true,
  "version": "alpha-0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.ts --fix",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit",
    "test:rules": "firebase emulators:exec --project test-project --only firestore \"node --test tests/firestore.invite.test.mjs\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@logtape/logtape": "^1.2.2",
    "axios": "^1.13.2",
    "firebase": "^12.5.0",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.1.7",
    "vue-tsc": "^3.1.0"
  },
  "lint-staged": {
    "*.{js,ts,vue,css,scss,json,md}": [
      "prettier --write"
    ],
    "*.{js,ts}": [
      "eslint --fix --ext .js,.ts"
    ]
  }
}
