{
  "name": "fliro",
  "private": true,
  "version": "alpha-0.2.40",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc -b && vite build",
    "prod": "vite --host --mode production",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.ts --fix",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit",
    "test:rules": "firebase emulators:exec --project test-project --only firestore \"node --test --test-concurrency=1 tests/firestore.*.test.mjs\"",
    "test:auth": "firebase emulators:exec --project test-project --only auth,firestore \"node --test --test-concurrency=1 tests/auth.test.mjs\"",
    "test": "firebase emulators:exec --project test-project --only auth,firestore \"node --test --test-concurrency=1 tests/*.test.mjs\"",
    "create-invite-code": "node scripts/createInviteCode.mjs",
    "set-admin": "node scripts/setAdmin.mjs",
    "release-notes": "node scripts/manageReleaseNotes.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@logtape/logtape": "^1.2.2",
    "axios": "^1.13.4",
    "canvas-confetti": "^1.9.4",
    "cropperjs": "^2.1.0",
    "firebase": "^12.8.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.0.3",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "firebase-admin": "^13.0.2",
    "firebase-tools": "^15.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vue-tsc": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,ts,vue,css,scss,json,md}": [
      "prettier --write"
    ],
    "*.{js,ts}": [
      "eslint --fix --ext .js,.ts"
    ]
  }
}
