rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /profiles/{userId} {
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && !exists(/databases/$(database)/documents/profiles/$(userId));
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && exists(/databases/$(database)/documents/profiles/$(userId));
      allow read: if isSignedIn();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    function getProject(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId));
    }

    function getMember(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    function hasRole(projectId, role) {
      let roles = getProject(projectId).data.roles;
      return isSignedIn()
        && roles is map
        && roles[role] is list
        && request.auth.uid in roles[role];
    }

    function legacyRole(projectId, role) {
      let member = getMember(projectId);
      return isSignedIn()
        && member.data != null
        && member.data.role == role;
    }

    function isProjectOwner(projectId) {
      return isSignedIn()
        && (getProject(projectId).data.ownerUserId == request.auth.uid
            || hasRole(projectId, 'owner')
            || legacyRole(projectId, 'owner'));
    }

    function isProjectAdmin(projectId) {
      return isProjectOwner(projectId)
        || hasRole(projectId, 'admin')
        || legacyRole(projectId, 'admin');
    }

    function isProjectMember(projectId) {
      let member = getMember(projectId);
      return isSignedIn()
        && (isProjectOwner(projectId)
            || hasRole(projectId, 'admin')
            || hasRole(projectId, 'member')
            || hasRole(projectId, 'guest')
            || member.data != null);
    }

    function isCreatingOwnProject() {
      return isSignedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.roles is map
        && request.resource.data.roles.owner is list
        && request.auth.uid in request.resource.data.roles.owner;
    }

    function isValidProjectCreate() {
      return request.resource.data.name is string
        && request.resource.data.description is string
        && request.resource.data.ownerUserId is string
        && request.resource.data.status in ['active','archived','completed']
        && request.resource.data.settings is map
        && request.resource.data.settings.isPublic is bool
        && request.resource.data.settings.allowGuestView is bool
        && request.resource.data.settings.defaultTaskStatus is string
        && request.resource.data.stats is map
        && request.resource.data.stats.totalTasks is int
        && request.resource.data.stats.completedTasks is int
        && request.resource.data.stats.totalMembers is int
        && (request.resource.data.stats.lastActivityAt is timestamp
            || request.resource.data.stats.lastActivityAt == null)
        && request.resource.data.roles is map
        && request.resource.data.roles.owner is list
        && request.resource.data.roles.admin is list
        && request.resource.data.roles.member is list
        && request.resource.data.roles.guest is list
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isInviteActive(invite, projectId) {
      return invite.data != null
        && invite.data.projectId == projectId
        && invite.data.status == 'pending'
        && (invite.data.expiresAt == null || invite.data.expiresAt > request.time)
        && (invite.data.maxUses == null || invite.data.usedCount < invite.data.maxUses);
    }

    function isValidInviteToken(token, projectId) {
      let invite = get(/databases/$(database)/documents/projects/$(projectId)/invites/$(token));
      let legacy = get(/databases/$(database)/documents/projectInvites/$(token));
      return isInviteActive(invite, projectId) || isInviteActive(legacy, projectId);
    }

    function ownerListNotEmpty() {
      return !(request.resource.data.roles is map)
        || (request.resource.data.roles.owner is list
            && request.resource.data.roles.owner.size() >= 1);
    }

    match /projects/{projectId} {
      allow create: if isCreatingOwnProject() && isValidProjectCreate();
      
      allow read: if resource.data.settings.isPublic == true 
                  || isProjectMember(projectId)
                  || (resource.data.settings.allowGuestView == true);
      
      allow update: if (
                        (isProjectOwner(projectId) && ownerListNotEmpty())
                        || (isProjectAdmin(projectId)
                            && resource.data.roles is map
                            && request.resource.data.roles is map
                            && request.resource.data.roles.owner == resource.data.roles.owner)
                        || (isProjectAdmin(projectId)
                            && !(resource.data.roles is map)
                            && !(request.resource.data.roles is map))
                      )
                    && request.resource.data.ownerUserId == resource.data.ownerUserId;
      allow delete: if isProjectOwner(projectId);

      match /members/{memberId} {
        allow create: if (isProjectOwner(projectId) || isProjectAdmin(projectId))
                      && request.resource.data.userId is string
                      && request.resource.data.role in ['owner','admin','member','guest']
                      && request.resource.data.joinedAt is timestamp
                      && request.resource.data.lastAccessedAt is timestamp
                      && request.resource.data.invitedBy is string
                      && (request.resource.data.email == null || request.resource.data.email is string)
                      && (request.resource.data.avatarUrl == null || request.resource.data.avatarUrl is string);
        
        allow create: if isSignedIn()
                      && memberId == request.auth.uid
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.role in ['owner','admin','member','guest']
                      && request.resource.data.joinedAt is timestamp
                      && request.resource.data.lastAccessedAt is timestamp
                      && request.resource.data.invitedBy is string
                      && (request.resource.data.email == null || request.resource.data.email is string)
                      && (request.resource.data.avatarUrl == null || request.resource.data.avatarUrl is string)
                      && request.resource.data.inviteToken is string
                      && isValidInviteToken(request.resource.data.inviteToken, projectId);
        
        allow read: if isProjectMember(projectId);
        allow update, delete: if isProjectOwner(projectId) || isProjectAdmin(projectId);
      }

      match /invites/{inviteId} {
        allow create: if isProjectAdmin(projectId)
                      && request.resource.data.projectId == projectId
                      && request.resource.data.token is string
                      && request.resource.data.createdBy == request.auth.uid
                      && request.resource.data.status == 'pending'
                      && request.resource.data.createdAt is timestamp
                      && request.resource.data.role in ['admin','member','guest']
                      && request.resource.data.type in ['link', 'email']
                      && (request.resource.data.passwordHash == null
                          || request.resource.data.passwordHash is string)
                      && (request.resource.data.expiresAt == null
                          || request.resource.data.expiresAt is timestamp)
                      && (request.resource.data.maxUses == null
                          || (request.resource.data.maxUses is int && request.resource.data.maxUses > 0))
                      && (request.resource.data.usedCount == null
                          || request.resource.data.usedCount == 0);

        allow read: if true;

        allow update: if isSignedIn()
                      && request.resource.data.projectId == resource.data.projectId
                      && request.resource.data.token == resource.data.token
                      && request.resource.data.createdBy == resource.data.createdBy
                      && request.resource.data.createdAt == resource.data.createdAt
                      && (resource.data.expiresAt == null 
                          || resource.data.expiresAt > request.time)
                      && (resource.data.maxUses == null 
                          || resource.data.usedCount < resource.data.maxUses)
                      && resource.data.status == 'pending'
                      && request.resource.data.status in ['pending', 'accepted']
                      && request.resource.data.acceptedBy == request.auth.uid
                      && request.resource.data.acceptedAt is timestamp
                      && request.resource.data.usedCount == resource.data.usedCount + 1
                      && request.resource.data.maxUses == resource.data.maxUses
                      && request.resource.data.expiresAt == resource.data.expiresAt
                      && request.resource.data.passwordHash == resource.data.passwordHash;
      }

      match /activities/{activityId} {
        allow create: if isProjectMember(projectId)
                      && request.resource.data.type is string
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.createdAt is timestamp;
        allow read: if isProjectMember(projectId)
                    || resource.parent().parent().data.settings.isPublic == true;
      }

      match /events/{eventId} {
        allow create: if isProjectMember(projectId)
                      && request.resource.data.v is int
                      && request.resource.data.type is string
                      && request.resource.data.origin in ['ui', 'command', 'bot', 'system']
                      && (request.resource.data.actorId == null || request.resource.data.actorId is string)
                      && request.resource.data.actorName is string
                      && request.resource.data.payload is map
                      && request.resource.data.createdAt is timestamp;
        allow read: if isProjectMember(projectId)
                    || resource.parent().parent().data.settings.isPublic == true;
      }

      match /tasks/{taskId} {
        allow create: if isProjectMember(projectId)
                      && request.resource.data.title is string
                      && request.resource.data.status is string
                      && request.resource.data.createdBy == request.auth.uid
                      && request.resource.data.createdAt is timestamp
                      && request.resource.data.updatedAt is timestamp;
        allow read: if isProjectMember(projectId)
                    || resource.parent().parent().data.settings.isPublic == true;
        allow update, delete: if isProjectMember(projectId);

        match /messages/{messageId} {
          allow read: if isProjectMember(projectId)
                      || resource.parent().parent().parent().data.settings.isPublic == true;
          allow create: if isProjectMember(projectId)
                        && request.resource.data.text is string
                        && request.resource.data.senderId == request.auth.uid
                        && request.resource.data.senderName is string
                        && request.resource.data.createdAt is timestamp
                        && request.resource.data.type in ['normal', 'decision'];
        }
      }

      match /threads/{threadId} {
        allow create: if isProjectMember(projectId)
                      && request.resource.data.name is string
                      && request.resource.data.createdBy == request.auth.uid
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.createdAt is timestamp
                      && request.resource.data.updatedAt is timestamp
                      && (request.resource.data.description == null || request.resource.data.description is string)
                      && (request.resource.data.isPublic == null || request.resource.data.isPublic is bool)
                      && (request.resource.data.allowedUserIds == null || request.resource.data.allowedUserIds is list);

        allow read: if isProjectMember(projectId)
                    || resource.parent().parent().data.settings.isPublic == true;
        
        allow update: if isProjectMember(projectId)
                      && request.auth.uid == resource.data.createdBy
                      && request.resource.data.createdBy == resource.data.createdBy
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.name is string
                      && (request.resource.data.description == null || request.resource.data.description is string)
                      && request.resource.data.updatedAt is timestamp;
        
        allow delete: if isProjectMember(projectId)
                      && request.auth.uid == resource.data.createdBy;
      }
    }

    match /{path=**}/invites/{inviteId} {
      allow read: if true;
    }

    match /userProjects/{userId}/projects/{projectId} {
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.projectName is string
                    && request.resource.data.role is string
                    && request.resource.data.lastAccessedAt is timestamp;
      allow read, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/projectRefs/{projectId} {
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.projectId is string
                    && request.resource.data.projectName is string
                    && request.resource.data.role in ['owner','admin','member','guest']
                    && (request.resource.data.joinedAt is timestamp
                        || request.resource.data.joinedAt == null)
                    && (request.resource.data.lastViewedAt is timestamp
                        || request.resource.data.lastViewedAt == null);
      allow read, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /pendingInvites/{inviteId} {
      allow create: if request.resource.data.inviteToken is string
                    && request.resource.data.email is string
                    && request.resource.data.projectId is string
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.status == 'pending';
      
      allow read: if true;
      
      allow update: if isSignedIn()
                    && (request.resource.data.userId == request.auth.uid
                        || request.resource.data.email == request.auth.token.email)
                    && request.resource.data.status in ['pending', 'completed'];
      
      allow delete: if isSignedIn()
                    && (resource.data.userId == request.auth.uid
                        || resource.data.email == request.auth.token.email);
    }

    match /projectInvites/{token} {
      allow create: if isSignedIn()
                    && request.resource.data.projectId is string
                    && (request.resource.data.projectName is string
                        || request.resource.data.projectName == null)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is timestamp
                    && (request.resource.data.passwordHash == null
                        || request.resource.data.passwordHash is string)
                    && (request.resource.data.expiresAt == null
                        || request.resource.data.expiresAt is timestamp)
                    && (request.resource.data.maxUses == null
                        || (request.resource.data.maxUses is int && request.resource.data.maxUses > 0))
                    && (request.resource.data.usedCount == null
                        || request.resource.data.usedCount == 0);

      allow read: if true;

      allow update: if isSignedIn()
                    && request.resource.data.projectId == resource.data.projectId
                    && request.resource.data.projectName == resource.data.projectName
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.createdAt == resource.data.createdAt
                    && (resource.data.expiresAt == null 
                        || resource.data.expiresAt > request.time)
                    && (resource.data.maxUses == null 
                        || resource.data.usedCount < resource.data.maxUses)
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['pending', 'accepted']
                    && request.resource.data.acceptedBy == request.auth.uid
                    && request.resource.data.acceptedAt is timestamp
                    && request.resource.data.usedCount == resource.data.usedCount + 1
                    && request.resource.data.maxUses == resource.data.maxUses
                    && request.resource.data.expiresAt == resource.data.expiresAt
                    && request.resource.data.passwordHash == resource.data.passwordHash;
    }
  }
}
